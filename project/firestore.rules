rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own user document
    // All authenticated users can read from users collection (fixes auth circular dependency)
    // Admins can write to any user document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Course access rules
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'trainer']);
      allow update: if request.auth != null && 
        (resource.data.instructorId == request.auth.uid || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Activity logs - read for all authenticated users, write for system only
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Enrollments - users can read their own, trainers can read enrollments containing their courses, admins can read all
    match /enrollments/{enrollmentId} {
      allow list, get: if request.auth != null && (
        // User reading their own enrollment
        request.auth.uid == enrollmentId ||
        request.auth.uid == resource.data.userId ||
        // Or authenticated user querying by userId (for collection queries)
        request.auth != null
      );
      allow write: if request.auth != null && 
        (request.auth.uid == enrollmentId || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'trainer']);
    }
    
    // Materials - all authenticated users can read, admin/trainer can write
    match /materials/{materialId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'trainer'];
    }
    
    // Feedback - users can write their own, admin/trainer can read all
    match /feedback/{feedbackId} {
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'trainer'];
      allow write: if request.auth != null;
    }
    
    // Training materials - all authenticated users can read/list, admin/trainer can write
    match /trainingMaterials/{materialId} {
      allow list, get: if request.auth != null;  // Explicit list and get for collection queries
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'trainer'];
    }
    
    // Feedbacks - participants or admin can manage
    match /feedbacks/{feedbackId} {
      allow read: if request.auth != null && (
        resource.data.trainerId == request.auth.uid || 
        resource.data.traineeId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow create: if request.auth != null && (
        request.resource.data.trainerId == request.auth.uid || 
        request.resource.data.traineeId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow update: if request.auth != null && (
        resource.data.trainerId == request.auth.uid || 
        resource.data.traineeId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if request.auth != null && (
        (resource.data.traineeId == request.auth.uid && resource.data.sender == 'trainee') ||
        (resource.data.trainerId == request.auth.uid && resource.data.sender == 'trainer') ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow list: if request.auth != null;
    }
    
    // Hidden messages - participants can manage their own hidden messages
    match /hiddenMessages/{hiddenId} {
      allow read, delete: if request.auth != null && (
        resource.data.get('trainerId', null) == request.auth.uid ||
        resource.data.get('traineeId', null) == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow create: if request.auth != null && (
        request.resource.data.get('trainerId', null) == request.auth.uid ||
        request.resource.data.get('traineeId', null) == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow list: if request.auth != null;
    }
    
    // Progress tracking
    match /progress/{progressId} {
      allow read, write: if request.auth != null && 
        (resource.data.userId == request.auth.uid || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'trainer']);
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && 
        (resource.data.userId == request.auth.uid || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Pending users - only admins can read and manage, but users can create their own
    match /pendingUsers/{userId} {
      allow read, delete: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    
    // Activity logs - all users can create their own logs, admins/trainers can manage
    match /activityLogs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.trainerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'trainer']
      );
      allow update, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'trainer'];
    }
    
    // Training Sessions - admins and trainers can manage, all authenticated users can read
    match /trainingSessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'trainer'];
    }
    
    // Sessions - publicly readable (for registration check), admin/trainer can write
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'trainer'];
    }
    
    // Grades - admin/trainer can manage, trainees can read their own
    match /grades/{gradeId} {
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'trainer'];
      allow read: if request.auth != null && 
        (resource.data.traineeId == request.auth.uid || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'trainer']);
    }
    
    // Final grades - admin/trainer can manage, trainees can read their own
    match /finalGrade/{finalGradeId} {
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'trainer'];
      allow read: if request.auth != null && 
        (resource.data.traineeId == request.auth.uid || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'trainer']);
    }
  }
}